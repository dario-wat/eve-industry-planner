# Sized for a 4 GB Raspberry Pi: MySQL uses ~1.2-1.4 GB, leaving room for the
# OS, Docker and the Node backend (phase 2).
[mysqld]
innodb_buffer_pool_size        = 1G
innodb_redo_log_capacity       = 512M
innodb_log_buffer_size         = 16M
innodb_flush_method            = O_DIRECT
# Flush the redo log once per second instead of on every commit. Far fewer
# writes to SD/SSD; a power cut can lose the last ~1s of writes. Set to 1 for
# full durability.
innodb_flush_log_at_trx_commit = 2

# Saves ~100-200 MB. Only needed for deep query diagnostics.
performance_schema             = OFF

max_connections                = 50
table_open_cache               = 1000
tmp_table_size                 = 32M
max_heap_table_size            = 32M
key_buffer_size                = 8M

skip-name-resolve
character-set-server           = utf8mb4
collation-server               = utf8mb4_0900_ai_ci
