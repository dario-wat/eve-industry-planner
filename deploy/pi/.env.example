# Copy to .env (git-ignored) and fill in. Passwords: no single quotes.

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=eve_industry_planner
# App user (DATABASE_USERNAME / DATABASE_PASSWORD in the repo-root .env).
MYSQL_USER=eip_app
MYSQL_PASSWORD=
# SELECT-only user (DATABASE_READONLY_* in the repo-root .env).
MYSQL_READONLY_USER=eip_readonly
MYSQL_READONLY_PASSWORD=

# Where MySQL keeps its data. Point at the SSD mount if you have one,
# e.g. /mnt/ssd/eip/mysql
MYSQL_DATA_DIR=./data/mysql
# 0.0.0.0 = LAN/Tailscale reachable; 127.0.0.1 = only the Pi itself.
MYSQL_BIND=0.0.0.0

# App server and jobs. Database settings are derived from the MYSQL_* values above.
SESSION_SECRET=
ESI_CLIENT_ID=
ESI_SECRET=
ESI_CALLBACK_URI=
CLIENT_DOMAIN=
