# Copy to .env (git-ignored) for local development. On the Pi, use deploy/pi/.env instead.

SERVER_PORT=8080
SESSION_SECRET=
# Set to 1 to serve HTTPS locally (see README.md).
USE_HTTPS_LOCAL=

# EVE SSO app. Without these, only public ESI endpoints work.
ESI_CLIENT_ID=
ESI_SECRET=
ESI_CALLBACK_URI=

# Origin of the client, for CORS.
CLIENT_DOMAIN=

DATABASE_HOST=
DATABASE_PORT=3306
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL=0

# SELECT-only user for .claude/skills/query-mysql.
DATABASE_READONLY_USERNAME=
DATABASE_READONLY_PASSWORD=
