{
  "name": "eve-sso",
  "version": "2.0.3",
  "description": "Eve Online Single Sign On (SSO) — local fork (JWT via jose, Node 26+)",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "author": "Michiel van der Velde <michiel@michielvdvelde.nl>",
  "homepage": "http://github.com/MichielvdVelde/eve-sso",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichielvdVelde/eve-sso.git"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "eve",
    "online",
    "sso",
    "esi"
  ],
  "license": "MIT",
  "scripts": {
    "build": "npm run clean && npm run build:cjs && npm run build:esm",
    "build:cjs": "tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', '{\\\"type\\\":\\\"commonjs\\\"}')\"",
    "build:esm": "tsc -p tsconfig.esm.json && node -e \"require('fs').writeFileSync('dist/esm/package.json', '{\\\"type\\\":\\\"module\\\"}')\"",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "form-urlencoded": "^6.1.4",
    "jose": "^6.1.3"
  },
  "devDependencies": {
    "@tsconfig/recommended": "^1.0.13",
    "typescript": "^5.9.3"
  }
}
