{
  "name": "eve-esi-client",
  "version": "0.7.0",
  "description": "Eve Online ESI client — local fork (fetch, nullable Provider, Node 26+)",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./providers/memory": {
      "import": {
        "types": "./dist/esm/providers/memory.d.ts",
        "default": "./dist/esm/providers/memory.js"
      },
      "require": {
        "types": "./dist/cjs/providers/memory.d.ts",
        "default": "./dist/cjs/providers/memory.js"
      }
    }
  },
  "author": "Michiel van der Velde <michiel@michielvdvelde.nl>",
  "homepage": "http://github.com/MichielvdVelde/eve-esi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichielvdVelde/eve-esi.git"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "eve",
    "online",
    "esi",
    "client",
    "sso"
  ],
  "license": "MIT",
  "scripts": {
    "build": "npm run clean && npm run build:cjs && npm run build:esm",
    "build:cjs": "tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', '{\\\"type\\\":\\\"commonjs\\\"}')\"",
    "build:esm": "tsc -p tsconfig.esm.json && node -e \"require('fs').writeFileSync('dist/esm/package.json', '{\\\"type\\\":\\\"module\\\"}')\"",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "eve-sso": "file:../eve-sso"
  },
  "devDependencies": {
    "@tsconfig/recommended": "^1.0.13",
    "@types/node": "^26.5.1",
    "typescript": "^5.9.3"
  }
}
